POSTGRES_PASSWORD=boxscheduler

# AI suggestions
# claude-cli: uses your Claude subscription. Run `claude setup-token` and paste the token below.
# anthropic-api: uses ANTHROPIC_API_KEY (billed per use).
# fake: canned plans for testing, none: disabled.
AI_PROVIDER=claude-cli
AI_MODEL=claude-opus-5-5
# Quicker model that tidies dictated requests before they are sent
AI_TIDY_MODEL=claude-haiku-5-5
CLAUDE_CODE_OAUTH_TOKEN=
# Leave empty when using the subscription; only read by AI_PROVIDER=anthropic-api.
ANTHROPIC_API_KEY=

# Host ports (change if they clash with something already running)
DB_PORT=5433
API_PORT=8080
WEB_PORT=3080

# Google sign-in: create an OAuth client (Web application) in Google Cloud Console and
# add the redirect URI http://localhost:3080/api/auth/google/callback (or PUBLIC_URL/...).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database login roles, created by the migrate step: app_service (app server) and
# app_admin (admin console). Use long random values.
SERVICE_DB_PASSWORD=
ADMIN_DB_PASSWORD=

# Accounts' own AI connections. AI_SECRET_KEY seals stored API keys (openssl rand -hex 32).
# AI_ALLOW_PRIVATE lets local LLMs on your network through, e.g. 192.168.0.0/16,mac-mini.local
AI_SECRET_KEY=
AI_ALLOW_PRIVATE=

# Team invite emails, sent by the service from its own domain through a mail provider.
# Resend (domain verified there): SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend,
# SMTP_PASS=<a Resend API key>, MAIL_FROM=Box Scheduler <noreply@box-scheduler.com>
# Left empty, invites are not emailed and the link is shown for copying instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
