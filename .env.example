POSTGRES_PASSWORD=boxscheduler

# AI suggestions
# claude-cli: uses your Claude subscription. Run `claude setup-token` and paste the token below.
# anthropic-api: uses ANTHROPIC_API_KEY (billed per use).
# fake: canned plans for testing, none: disabled.
AI_PROVIDER=claude-cli
AI_MODEL=claude-opus-5-5
# Quicker model that tidies dictated requests before they are sent
AI_TIDY_MODEL=claude-haiku-5-5
CLAUDE_CODE_OAUTH_TOKEN=
# Leave empty when using the subscription; only read by AI_PROVIDER=anthropic-api.
ANTHROPIC_API_KEY=

# Host ports (change if they clash with something already running)
DB_PORT=5433
API_PORT=8080
WEB_PORT=3080
