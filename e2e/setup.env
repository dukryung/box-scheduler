# Throwaway stack for setup-check.mjs: a fresh database to claim the owner account in.
# docker compose -p boxtest --env-file e2e/test.env up -d --build
POSTGRES_PASSWORD=boxtest
AI_PROVIDER=fake
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
DB_PORT=5643
API_PORT=8280
WEB_PORT=3280
SETUP_TOKEN=setup-check-token
# Tests sign up and log in many times from one address
LOGIN_LIMIT_PER_IP=1000
SIGNUP_LIMIT_PER_IP=1000
# Google sign-in against e2e/fake-google.mjs (the browser uses localhost, the API container host.docker.internal)
GOOGLE_CLIENT_ID=e2e-client
GOOGLE_CLIENT_SECRET=e2e-secret
GOOGLE_AUTH_URL=http://localhost:3199/auth
GOOGLE_TOKEN_URL=http://host.docker.internal:3199/token
